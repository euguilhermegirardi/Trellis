#!/usr/bin/env bash
# Trellis pre-push: refuses pushes to (and deletion of) protected branches.
# Protected branches default to main and master; add more, one per line, in
# .trellis/protected-branches.txt. A human who really needs to push can use `git push --no-verify`;
# agents must not.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
protected="main
master"
if [ -f "$root/.trellis/protected-branches.txt" ]; then
  protected="$protected
$(grep -vE '^[[:space:]]*(#|$)' "$root/.trellis/protected-branches.txt" || true)"
fi

zero="0000000000000000000000000000000000000000"
rc=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  branch="${remote_ref#refs/heads/}"
  while IFS= read -r b; do
    [ -z "$b" ] && continue
    if [ "$branch" = "$b" ]; then
      if [ "$local_sha" = "$zero" ]; then
        echo "Push blocked: deleting protected branch '$b'." >&2
      else
        echo "Push blocked: '$b' is protected. Push a feature branch and open a pull request." >&2
      fi
      rc=1
    fi
  done <<< "$protected"
done
exit "$rc"
